# Copie para .env no servidor. Nunca envie .env ao GitHub ou ao APK.
PORT=3001
APP_URL=http://localhost:3001

# Obrigatória para a MAX AI; configure apenas no backend hospedado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: deixe vazio para permitir fallback configurado no backend.
GEMINI_API_ENDPOINT=

# Obrigatória para autenticar o endpoint de webhook Pix atualmente existente.
# Isso NÃO integra um provedor Pix; o provedor real ainda precisa ser implementado.
PIX_WEBHOOK_SECRET=

# Opcional no build do app: URL pública do backend para login e chamadas da MAX AI.
# Também é possível informar/salvar a URL na tela de login do APK.
VITE_API_URL=
VITE_APP_URL=

# Asaas Sandbox: configuracao privada somente no backend.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
